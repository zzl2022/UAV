# Windows batch launchers must stay CRLF so ZIP downloads work.
*.bat -text
*.cmd -text
*.ps1 text eol=crlf
*.sh text eol=lf

# Raw competition data must stay byte-identical (source hashes).
创意二文件/** -text

# Binaries
*.glb binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.tif binary
*.tiff binary
