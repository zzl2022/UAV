{
  "name": "uav-city-modeler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "prepare:data": ".venv/bin/python scripts/prepare_data.py",
    "export:model": "node scripts/export_model.js",
    "test:browser": "node scripts/browser_smoke.js",
    "test:imagery": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "playwright-core": "1.61.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
